rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Cada administrador só pode gerenciar arquivos da empresa vinculada ao seu token.
    match /empresas/{empresaId}/branding/{fileName} {
      allow read: if request.auth != null
        && request.auth.token.ativo == true
        && request.auth.token.role == 'admin'
        && request.auth.token.empresaId == empresaId;

      allow write: if request.auth != null
        && request.auth.token.ativo == true
        && request.auth.token.role == 'admin'
        && request.auth.token.empresaId == empresaId
        && request.resource != null
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }
  }
}
